# Salin ke .env.dev di VPS (direktori keyloka-api-dev). Jangan commit .env.dev.
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://dev.keyloka.com
FRONTEND_URL=https://dev.keyloka.com

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=keyloka_dev
# Dev: biarkan true agar skema dibuat otomatis di DB dev yang kosong (cek perilaku di src/ sebelum dipakai)
DB_SYNCHRONIZE=true

JWT_SECRET=replace_with_DIFFERENT_random_secret_for_dev

# Midtrans SANDBOX
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CLIENT_KEY=your_sandbox_client_key
MIDTRANS_SERVER_KEY=your_sandbox_server_key

# Cloudflare R2 (bucket dev terpisah)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=properties-dev
R2_PUBLIC_URL=https://media-dev.keyloka.com

# Email: log saja agar tidak terkirim ke user sungguhan
MAIL_PROVIDER=log
MAIL_FROM="Keyloka Dev <no-reply@keyloka.com>"
