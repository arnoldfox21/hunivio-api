# Server
PORT=3001
NODE_ENV=production
# Di production, kunci ke domain frontend (pisahkan koma jika lebih dari satu), misal: https://keyloka.com
CORS_ORIGIN=https://keyloka.com

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=keyloka_db
DB_SYNCHRONIZE=false

# Local / Direct DATABASE_URL (dipakai saat menjalankan di luar Docker)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/keyloka_db

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_SERVER_KEY=your_midtrans_server_key

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=properties
R2_PUBLIC_URL=https://media.keyloka.com
