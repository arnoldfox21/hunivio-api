{
  "name": "hunigo-api",
  "version": "1.0.0",
  "description": "NestJS + PostgreSQL Backend API for HuniGo (Kost Listing & Booking App)",
  "private": true,
  "scripts": {
    "db:up": "bash ./ensure-postgres.sh",
    "build": "tsc",
    "prestart": "bash ./ensure-postgres.sh && tsc",
    "start": "node dist/main.js",
    "start:dev": "bash ./ensure-postgres.sh && tsc && node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.2"
  }
}
